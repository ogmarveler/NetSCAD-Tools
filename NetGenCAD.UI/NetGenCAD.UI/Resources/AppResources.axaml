<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:NetGenCAD.UI.Converters;assembly=NetGenCAD.UI"
    xmlns:local="clr-namespace:NetGenCAD.UI.Views;"
    xmlns:model="clr-namespace:NetGenCAD.UI.Models"
    xmlns:views="using:NetGenCAD.UI.Views"
    xmlns:vm="clr-namespace:NetGenCAD.UI.ViewModels;assembly=NetGenCAD.UI"
    x:CompileBindings="True">

    <!--  Converters  -->
    <conv:DoubleToNullableConverter x:Key="DoubleToNullableConverter" />
    <conv:IntToNullableConverter x:Key="IntToNullableConverter" />
    <conv:UnitTextConverter x:Key="UnitTextConverter" />
    <conv:BooleanToTextConverter x:Key="BooleanToTextConverter" />
    <conv:BooleanOrConverter x:Key="BooleanOrConverter" />
    <conv:CollectionCountToBooleanConverter x:Key="CollectionCountToBooleanConverter" />
    <conv:CollectionCountToTextConverter x:Key="CollectionCountToTextConverter" />
    <conv:StringNotNullOrEmptyConverter x:Key="StringNotNullOrEmptyConverter" />
    <conv:MultiStringNotNullOrEmptyConverter x:Key="MultiStringNotNullOrEmptyConverter" />
    <conv:ShapeValidationConverter x:Key="ShapeValidationConverter" />
    <conv:EnumDescriptionConverter x:Key="EnumDescriptionConverter" />
    <conv:UnitSystemToColorConverter x:Key="UnitSystemToColorConverter" />
    <conv:AxisDisplayConverter x:Key="AxisDisplayConverter" />
    <conv:ModuleTypeToColorConverter x:Key="ModuleTypeToColorConverter" />
    <conv:ThemeToIconConverter x:Key="ThemeToIconConverter" />
    <conv:StringEqualityConverter x:Key="StringEqualityConverter" />
    <conv:PolyhedronOperationTypeConverter x:Key="PolyhedronOperationTypeConverter" />
    <conv:PolyhedronOperationTypeToColorConverter x:Key="PolyhedronOperationTypeToColorConverter" />
    <conv:PolyhedronValidationConverter x:Key="PolyhedronValidationConverter" />

    <Design.PreviewWith>
        <Border Padding="20">
            <!--  Add Controls for Previewer Here  -->
        </Border>
    </Design.PreviewWith>
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="CardBackground" Color="White" />
            <SolidColorBrush x:Key="CardForeground" Color="Black" />
            <SolidColorBrush x:Key="WindowBackground" Color="#F5F5F5" />
            <SolidColorBrush x:Key="LabelBackground" Color="#DADDE2" />
            <SolidColorBrush x:Key="PurpleBackground" Color="#423443" />
            <SolidColorBrush x:Key="PurpleForeground" Color="#ffedff" />
            <SolidColorBrush x:Key="TealForeground" Color="#c0fcf7" />
            <SolidColorBrush x:Key="TealBackground" Color="#48817c" />
            <SolidColorBrush x:Key="BlueForeground" Color="#dfe5f6" />
            <SolidColorBrush x:Key="BlueBackground" Color="#617aaa" />
            <SolidColorBrush x:Key="RedBackground" Color="#fff4f4" />
            <SolidColorBrush x:Key="RedForeground" Color="#b4676b" />
            <SolidColorBrush x:Key="GoldForeground" Color="#ffeecb" />
            <SolidColorBrush x:Key="GoldBackground" Color="#77623c" />
            <SolidColorBrush x:Key="SilverForeground" Color="#efefef" />
            <SolidColorBrush x:Key="SilverBackground" Color="#838383" />
            <SolidColorBrush x:Key="MaroonForeground" Color="#f1e4f3" />
            <SolidColorBrush x:Key="MaroonBackground" Color="#7a4c5f" />
            <SolidColorBrush x:Key="DarkBlueForeground" Color="#f2ecff" />
            <SolidColorBrush x:Key="DarkBlueBackground" Color="#514e65" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="CardBackground" Color="#212121" />
            <SolidColorBrush x:Key="CardForeground" Color="White" />
            <SolidColorBrush x:Key="WindowBackground" Color="#121212" />
            <SolidColorBrush x:Key="LabelBackground" Color="#545F66" />
            <SolidColorBrush x:Key="PurpleBackground" Color="#ffedff" />
            <SolidColorBrush x:Key="PurpleForeground" Color="#423443" />
            <SolidColorBrush x:Key="TealBackground" Color="#c0fcf7" />
            <SolidColorBrush x:Key="TealForeground" Color="#48817c" />
            <SolidColorBrush x:Key="BlueBackground" Color="#dfe5f6" />
            <SolidColorBrush x:Key="BlueForeground" Color="#617aaa" />
            <SolidColorBrush x:Key="RedForeground" Color="#fff4f4" />
            <SolidColorBrush x:Key="RedBackground" Color="#b4676b" />
            <SolidColorBrush x:Key="GoldBackground" Color="#ffeecb" />
            <SolidColorBrush x:Key="GoldForeground" Color="#77623c" />
            <SolidColorBrush x:Key="SilverBackground" Color="#efefef" />
            <SolidColorBrush x:Key="SilverForeground" Color="#838383" />
            <SolidColorBrush x:Key="MaroonBackground" Color="#f1e4f3" />
            <SolidColorBrush x:Key="MaroonForeground" Color="#7a4c5f" />
            <SolidColorBrush x:Key="DarkBlueBackground" Color="#f2ecff" />
            <SolidColorBrush x:Key="DarkBlueForeground" Color="#514e65" />

        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!--  Axes Combo Box  -->
    <StackPanel x:Key="AxesComboBox" x:DataType="vm:ScadObjectViewModel">
        <ComboBox
            Classes="card"
            IsEnabled="{Binding AxesSelectEnabled}"
            ItemsSource="{Binding AxesList}"
            SelectedValue="{Binding SelectedAxisValue}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
    </StackPanel>

    <!--  Theme Combo Box  -->
    <StackPanel x:Key="BackgroundComboBox" x:DataType="vm:CreateAxesViewModel">
        <ComboBox
            Classes="card"
            ItemsSource="{Binding BackgroundTypeValues}"
            SelectedValue="{Binding SelectedBackgroundValue}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
    </StackPanel>
</ResourceDictionary>